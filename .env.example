# DealProof environment configuration.
# Copy this file to `.env` and fill in real values for anything beyond local
# dev. `.env` is git-ignored; this template is the only copy that's committed.

# --- Core -------------------------------------------------------------------

# development | staging | production
ENV=development

# --- Database & queue ---------------------------------------------------

# Postgres 16 (SPEC §7). Matches the `db` service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://dealproof:dealproof@db:5432/dealproof

# Redis, used as the Celery broker/result backend for async pipeline runs.
REDIS_URL=redis://redis:6379/0

# --- LLM ---------------------------------------------------------------

# Anthropic API key for the Claude orchestration pipeline (SPEC §2.3, Stages
# 1/2/5). Leave empty to run fully offline: the pipeline falls back to a
# deterministic template narrator so tests/demos work with no API access.
ANTHROPIC_API_KEY=

# --- Object storage (S3-compatible; MinIO in dev, S3 in prod) ------------

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=dealproof-docs

# --- Billing (SPEC §6 pricing tiers) ------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------

RESEND_API_KEY=

# --- Security ------------------------------------------------------------

# Change this in every non-local environment.
JWT_SECRET=change-me

# How long a signed document/report URL stays valid.
SIGNED_URL_TTL_SECONDS=900

# How long uploaded documents/reports are retained before deletion.
DATA_RETENTION_DAYS=180

# --- Observability -------------------------------------------------------

# Leave empty to disable Sentry error reporting.
SENTRY_DSN=
