# Single-service production image: FastAPI serves the API AND the built React UI.
# Used by the cloud deploy (render.yaml). The pipeline runs inline in the API,
# so no Redis/Celery/MinIO are required for a hosted demo — just this + Postgres.

# --- Stage 1: build the frontend -------------------------------------------
FROM node:22-alpine AS web
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# --- Stage 2: python runtime serving API + static frontend -----------------
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# WeasyPrint runtime libs (for the report PDF) + build tools for wheels.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential libffi-dev \
      libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 libcairo2 \
      libjpeg62-turbo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/ ./backend/
RUN pip install ./backend

# Ship the built SPA alongside the API.
COPY --from=web /app/frontend/dist ./frontend/dist
ENV FRONTEND_DIST=/app/frontend/dist \
    ENV=development

WORKDIR /app/backend
EXPOSE 8000
# Render/Railway inject $PORT; default to 8000 locally.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
